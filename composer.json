{
    "name": "dennieos/laravel-signals",
    "description": "Client error intake for DennieOS: stores scrubbed errors in your own database and serves them through one signed, read-only route (contract v1).",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "dennieos", "errors", "monolog"],
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dennieos\\LaravelSignals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dennieos\\LaravelSignals\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dennieos\\LaravelSignals\\SignalsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
